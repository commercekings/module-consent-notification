{
    "name": "commercekings/module-consent-notification",
    "description": "Connects commercekings/module-consent to commercekings/module-notification: subscriptions need a valid consent, and withdrawing it removes them. Install it for consent-based notifications; leave it out for opt-out.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "CommerceKings"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0",
        "magento/module-store": "^101.1",
        "commercekings/module-consent": "^0.1 || ^0.2",
        "commercekings/module-notification": "^0.1",
        "commercekings/consent-source": "^0.1"
    },
    "suggest": {
        "commercekings/module-consent-vanilla": "A consent banner. Or any package that provides commercekings/consent-source."
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceKings\\ConsentNotification\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/Test/",
            "/.github/",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "homepage": "https://github.com/commercekings/module-consent-notification",
    "support": {
        "issues": "https://github.com/commercekings/module-consent-notification/issues",
        "source": "https://github.com/commercekings/module-consent-notification"
    }
}
